{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    ".dagger/**"
  ],
  "packageRules": [
    {
      "description": "redisearch-go v2 cannot be adopted while sthingsCli exposes v1 client types; see #77",
      "matchPackageNames": ["github.com/RediSearch/redisearch-go"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
